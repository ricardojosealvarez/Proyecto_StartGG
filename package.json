{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "db:migrate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres.ps1 migrate",
    "db:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres.ps1 start",
    "db:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/postgres.ps1 status",
    "lint": "eslint .",
    "format": "prettier --write server database src/components/PlayerPrediction.tsx src/components/PlayerPrediction.test.tsx src/lib/predictions.ts src/App.tsx package.json vite.config.ts tsconfig.node.json eslint.config.js",
    "history:import": "node --experimental-transform-types server/cli/importHistory.ts",
    "history:import-player": "node --experimental-transform-types server/cli/importPlayerHistory.ts",
    "tournaments:import-tiers": "node --experimental-transform-types server/cli/importTournamentTiers.ts",
    "ratings:rebuild": "node --experimental-transform-types server/cli/rebuildRatings.ts",
    "characters:backfill": "node --experimental-transform-types server/cli/backfillCharacterStats.ts",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.24.1",
    "clsx": "^2.1.0",
    "exceljs": "^4.4.0",
    "glicko2": "^1.2.1",
    "graphql": "^16.8.1",
    "graphql-request": "^6.1.0",
    "lucide-react": "^0.344.0",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/pg": "^8.21.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2",
    "vitest": "^4.1.10"
  }
}
